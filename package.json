{
  "name": "drop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Envio de archivos P2P entre navegadores (WebRTC). El servidor solo empareja: los archivos nunca pasan por el.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "cli": "node cli/src/cli.js",
    "build:exe": "node scripts/build-cross.mjs win-x64",
    "build:linux": "node scripts/build-cross.mjs linux-x64",
    "build:arm": "node scripts/build-cross.mjs linux-arm64",
    "build:macos": "node scripts/build-cross.mjs darwin-arm64",
    "build:macos-x64": "node scripts/build-cross.mjs darwin-x64",
    "build:all": "node scripts/build-cross.mjs all",
    "install:bin": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "test": "node --test test/*.test.mjs",
    "bench": "node test/throughput.bench.mjs",
    "bench:fanout": "node test/fanout.bench.mjs",
    "bench:cli": "node test/cli.bench.mjs",
    "bench:speed": "node test/speed.bench.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
