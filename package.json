{
  "name": "drop",
  "version": "0.13.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Àlex Rodriguez (Oloxx)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oloxx/drop.git"
  },
  "type": "module",
  "description": "Envio de archivos P2P entre navegadores (WebRTC). El servidor solo empareja: los archivos nunca pasan por el.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "keygen": "node scripts/keygen.mjs",
    "sign": "node scripts/sign-release.mjs",
    "cli": "cargo run --manifest-path cli-rs/Cargo.toml --",
    "build:cli": "cargo build --release --manifest-path cli-rs/Cargo.toml",
    "build:exe": "cargo build --release --manifest-path cli-rs/Cargo.toml --target x86_64-pc-windows-msvc",
    "build:linux": "cargo build --release --manifest-path cli-rs/Cargo.toml --target x86_64-unknown-linux-musl",
    "build:arm": "cargo build --release --manifest-path cli-rs/Cargo.toml --target aarch64-unknown-linux-musl",
    "build:macos": "cargo build --release --manifest-path cli-rs/Cargo.toml --target aarch64-apple-darwin",
    "build:macos-x64": "cargo build --release --manifest-path cli-rs/Cargo.toml --target x86_64-apple-darwin",
    "install:bin": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "bench": "node test/throughput.bench.mjs",
    "bench:fanout": "node test/fanout.bench.mjs",
    "bench:cli": "node test/cli.bench.mjs",
    "bench:speed": "node test/speed.bench.mjs",
    "bench:webrelay": "node test/webrelay.bench.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
