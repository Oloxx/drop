# ---------------------------------------------------------------- app
PORT=3000

# ------------------------------------------------- despliegue en VPS
# Dominio con HTTPS (Caddy saca el certificado para el). Si no tienes uno,
# DuckDNS da subdominios gratis: mi-drop.duckdns.org
DROP_DOMAIN=drop.tudominio.com

# IPs de la instancia. La publica la ves en la consola de Oracle; la privada
# con `ip -4 addr show` dentro de la maquina (suele ser 10.0.0.x).
# coturn las necesita las dos porque Oracle hace NAT 1:1.
PUBLIC_IP=
PRIVATE_IP=

# ------------------------------------------------------------- origenes
# El servidor solo acepta WebSockets de navegador desde estos origenes, para que
# una web cualquiera no pueda abrir salas usando el navegador de quien la visita.
# Por defecto ya valen https://DROP_DOMAIN y localhost, asi que esto solo hace
# falta si sirves el frontend desde otro sitio. Separa varios por comas.
# Las conexiones sin cabecera Origin (el CLI) no se ven afectadas.
# DROP_ALLOWED_ORIGINS=https://drop.tudominio.com,https://otro.tudominio.com

# ---------------------------------------------------------------- TURN
# Secreto compartido entre el servidor y coturn. NO es una contraseña de usuario:
# el servidor firma con el credenciales que caducan solas y coturn las valida sin
# guardar ninguna. Sin esto no se sirve TURN (la app funciona, pero las conexiones
# que necesitan reenvio fallan). Generalo con:
#
#   openssl rand -hex 32
#
TURN_SECRET=

# Cuanto vive cada credencial que reparte /config, en segundos. Por defecto 12h.
# Bajarlo acota lo que puede hacer alguien que se lleve una del navegador.
# TURN_TTL_SECONDS=43200

# Si usas un TURN gestionado en vez del coturn de docker-compose, pon aqui su URL.
# La pila del compose la construye sola a partir de DROP_DOMAIN.
# TURN_URL=turn:otro-servidor:3478

# ------------------------------------------------------------- limites
# Cuotas del servidor de senalizacion. Los valores por defecto estan muy por
# encima del uso normal; solo hace falta tocarlos en un despliegue raro.
# DROP_ROOM_RATE_MAX=30        # salas nuevas por IP y minuto
# DROP_MAX_GUESTS=25           # receptores por sala
# DROP_MAX_ROOMS=5000          # salas simultaneas en memoria
# DROP_ROOM_TTL_MS=1800000     # cierra una sala tras 30 min sin actividad
# DROP_MSG_BURST=300           # rafaga de mensajes de control por socket
# DROP_MSG_RATE=100            # y su recarga por segundo
